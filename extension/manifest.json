{
  "manifest_version": 3,
  "name": "Vinil — музыка как с пластинки",
  "short_name": "Vinil",
  "version": "0.1.0",
  "description": "Любая музыка со звуком виниловой пластинки: игла, треск и тёплый ламповый звук.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Открыть Vinil" },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus"],
  "host_permissions": [
    "https://*.audius.co/*",
    "https://*.audius.org/*",
    "https://archive.org/*",
    "https://*.archive.org/*"
  ]
}
